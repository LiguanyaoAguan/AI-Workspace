# 系统元数据
.DS_Store

# Python
__pycache__/
*.pyc

# 运行时数据：基线、日志、快照、操作记录
.ai-workspace/state.json
.ai-workspace/changes.log
.ai-workspace/backup/*
!.ai-workspace/backup/.gitkeep
.ai-workspace/ops/*
!.ai-workspace/ops/.gitkeep

# 私人长期记忆（dsh-mnemon，本地专用，绝不提交）
.ai-workspace/mnemon/
.ai-workspace/mnemon/**

# 凭据（永远不要提交）
.env
*.key
*.pem
token*
