# 系统元数据
.DS_Store

# Python
__pycache__/
*.pyc

# 运行时数据：基线、日志、快照、操作记录
.ai-workspace/state.json
.ai-workspace/changes.log
.ai-workspace/backup/*
!.ai-workspace/backup/.gitkeep
.ai-workspace/ops/*
!.ai-workspace/ops/.gitkeep

# 私人长期记忆（dsh-mnemon，本地专用，绝不提交）
.ai-workspace/mnemon/
.ai-workspace/mnemon/**

# 记忆备份包（含私人记忆，只留在本机）
.ai-workspace/mnemon-backups/

# 视频转写 ASR 模型（155MB 二进制，只在本机）
.ai-workspace/vtc-models/

# 插件安装包与测试会话备份（本机运行时数据）
.ai-workspace/plugins/
.ai-workspace/session-backup*/

# ---- 个人内容：只留在本机，不进 GitHub ----
# GitHub 仓库只承载工作流/框架本身；素材与产出属于个人数据
04_素材库/*
!04_素材库/.gitkeep
!04_素材库/README.md

# 01_项目库：项目文档属于个人内容，只保留总表骨架
01_项目库/*
!01_项目库/项目总表.md
!01_项目库/.gitkeep

# 02_知识库：知识条目属于个人积累，只保留骨架与索引
02_知识库/*
!02_知识库/README.md
!02_知识库/索引.md
!02_知识库/.gitkeep

# 平台登录 cookie（等同凭据）
03_技能库/video-transcript/cookies-*.txt

# 凭据（永远不要提交）
.env
*.key
*.pem
token*
