#!/data/data/com.dsharnessmobile.shell/files/usr/bin/bash
# vtc —— 视频文案采集器入口（Pad 原生版）
# 自动把 sherpa-onnx 原生库目录加进 LD_LIBRARY_PATH 再调 vtc.py
export PATH="${PREFIX:-/data/data/com.dsharnessmobile.shell/files/usr}/bin:/system/bin"
PY="${PREFIX:-/data/data/com.dsharnessmobile.shell/files/usr}/bin/python3"
SL="$("$PY" -c 'import site;print(site.getsitepackages()[0])' 2>/dev/null)/sherpa_onnx/lib"
if [ -d "$SL" ]; then
  export LD_LIBRARY_PATH="$SL:${LD_LIBRARY_PATH:-}"
fi
exec "$PY" "$(dirname "$(readlink -f "$0")")/vtc.py" "$@"
